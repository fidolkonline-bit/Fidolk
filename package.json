{
  "name": "fido-lk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "format": "prettier --write 'app/**/*.{ts,tsx,css}' 'lib/**/*.ts' 'scripts/**/*.ts' 'tests/**/*.ts' package.json tsconfig.json",
    "format:check": "prettier --check 'app/**/*.{ts,tsx,css}' 'lib/**/*.ts' 'scripts/**/*.ts' 'tests/**/*.ts' package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:setup": "tsx scripts/setup-db.ts",
    "backup": "tsx scripts/backup.ts",
    "vapid:generate": "tsx scripts/generate-vapid.ts",
    "production:check": "tsx scripts/validate-production.ts && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
