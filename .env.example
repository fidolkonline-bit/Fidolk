# Without DATABASE_URL the app uses clearly labelled, local demo storage.
DATABASE_URL=
# PostgreSQL connections per application instance (1-20).
DATABASE_POOL_MAX=5
# One-time owner bootstrap key. Generate a long random value.
APP_ACCESS_KEY=
# Separate 32-byte base64 key for repair credentials and the SMS token.
APP_ENCRYPTION_KEY=
# Bearer secret used by the scheduled /api/jobs worker.
CRON_SECRET=
# Generate with: npm run vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# Generate/store separately from the database. Never commit secrets.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups
